AIRFLOW_UID=50000

# Airflow metadata DB
AIRFLOW_METADATA_DSN=postgresql+psycopg2://postgres:postgres@host.docker.internal:5432/data_lake

# Separate audit DB
AUDIT_DATABASE_DSN=postgresql+psycopg2://postgres:postgres@host.docker.internal:5432/dag_audit

# Keycloak Airflow 
AIRFLOW__API__BASE_URL=http://localhost:8088
AIRFLOW__API__WORKERS=1
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/
AIRFLOW__API_AUTH__JWT_SECRET=airflow-execution-api-jwt-secret
AIRFLOW_OAUTH_CLIENT_ID=airflow-auth
AIRFLOW_OAUTH_CLIENT_SECRET=airflow-auth-secret
AIRFLOW_OAUTH_ISSUER_URL=http://localhost:8081/realms/vkr
AIRFLOW_OAUTH_INTERNAL_ISSUER_URL=http://host.docker.internal:8081/realms/vkr
AIRFLOW_OAUTH_PROVIDER_NAME=keycloak
AIRFLOW_OAUTH_SCOPE=openid email profile

# Contract registry service from
CONTRACTS_SERVICE_URL=http://host.docker.internal:8000
CONTRACTS_OIDC_TOKEN_URL=http://host.docker.internal:8081/realms/vkr/protocol/openid-connect/token
CONTRACTS_OIDC_CLIENT_ID=airflow-contracts
CONTRACTS_OIDC_CLIENT_SECRET=airflow-contracts-secret
CONTRACTS_OIDC_SCOPE=
CONTRACTS_OIDC_VERIFY_SSL=false

# Landing zone in MinIO from
LANDING_S3_BUCKET=ingestion-landing
LANDING_S3_PREFIX=accepted
LANDING_S3_ENDPOINT_URL=http://host.docker.internal:9000
LANDING_S3_REGION=us-east-1
LANDING_S3_VERIFY_SSL=false

# Keycloak MinIO
KEYCLOAK_TOKEN_URL=http://host.docker.internal:8081/realms/vkr/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=airflow-minio-sts
KEYCLOAK_CLIENT_SECRET=airflow-minio-sts-secret
MINIO_STS_ENDPOINT=http://host.docker.internal:9000
MINIO_STS_DURATION_SECONDS=3600

# Optional static fallback. Leave empty when using STS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
