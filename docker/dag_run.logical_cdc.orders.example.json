{
  "namespace": "sales",
  "name": "orders",
  "source_dsn": "postgresql+psycopg2://postgres:postgres@host.docker.internal:5432/source_db",
  "source_replication_dsn": "postgresql://postgres:postgres@host.docker.internal:5432/source_db",
  "source_admin_dsn": "postgresql+psycopg2://postgres:postgres@host.docker.internal:5432/source_db",
  "source_table": "public.orders",
  "source_publication_name": "pub_ingestion_sales_orders",
  "source_slot_name": "slot_ingestion_sales_orders",
  "output_plugin": "pgoutput",
  "auto_setup_logical_cdc": true,
  "auto_configure_wal_settings": true,
  "desired_max_replication_slots": 10,
  "desired_max_wal_senders": 10,
  "replace_existing_publication": false,
  "create_slot_if_missing": true,
  "replica_identity_mode": "default",
  "target_dsn": "postgresql+psycopg2://postgres:postgres@host.docker.internal:5432/data_lake",
  "target_table_curated": "curated.orders",
  "landing_s3_bucket": "ingestion-landing",
  "landing_s3_prefix": "accepted",
  "landing_s3_endpoint_url": "http://host.docker.internal:9000",
  "landing_s3_region": "us-east-1",
  "landing_s3_verify_ssl": false,
  "max_extract_seconds": 30,
  "idle_timeout_seconds": 3,
  "apply_load_batch_size": 1000,
  "upsert_batch_size": 1000
}
